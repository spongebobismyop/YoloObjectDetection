# ── CELL 6: detect_image & detect_video helpers ──────────────
def detect_image(image_pil, obj_thresh=0.4, nms_thresh=0.45, net_h=416, net_w=416):
    image_w, image_h = image_pil.size
    new_image = preprocess_input(image_pil, net_h, net_w)
    yolo_outputs = darknet.predict(new_image, verbose=0)
    boxes = decode_netout(yolo_outputs, obj_thresh, anchors, image_h, image_w, net_h, net_w)
    boxes = do_nms(boxes, nms_thresh, obj_thresh)
    return draw_boxes(image_pil, boxes, labels)


def detect_video(video_path, output_path, obj_thresh=0.4, nms_thresh=0.45, net_h=416, net_w=416):
    vid = cv2.VideoCapture(video_path)
    if not vid.isOpened():
        raise IOError(f"Couldn't open video: {video_path}")

    fourcc     = cv2.VideoWriter_fourcc(*'mp4v')
    fps        = vid.get(cv2.CAP_PROP_FPS)
    video_size = (int(vid.get(cv2.CAP_PROP_FRAME_WIDTH)),
                  int(vid.get(cv2.CAP_PROP_FRAME_HEIGHT)))
    out = cv2.VideoWriter(output_path, fourcc, fps, video_size)

    num_frame = 0
    while vid.isOpened():
        ret, frame = vid.read()
        if not ret:
            break
        num_frame += 1
        print(f"=== Frame {num_frame} ===")

        frame_rgb  = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        frame_pil  = Image.fromarray(frame_rgb)
        result_pil = detect_image(frame_pil, obj_thresh, nms_thresh, net_h, net_w)
        result_bgr = cv2.cvtColor(np.asarray(result_pil), cv2.COLOR_RGB2BGR)

        if (result_bgr.shape[1], result_bgr.shape[0]) != video_size:
            result_bgr = cv2.resize(result_bgr, video_size)
        out.write(result_bgr)

    vid.release()
    out.release()
    print(f"Done! Saved to {output_path}")


